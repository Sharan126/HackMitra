# ==============================================================================
# HackMitra Environment Variables Configuration
# ==============================================================================
# Instructions:
# 1. Copy this file to .env.local:
#    cp .env.example .env.local
# 2. Fill in your Supabase project credentials from your Supabase dashboard:
#    Project Settings -> API
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Client-Side Public Supabase Credentials (Safe for browser, RLS-enforced)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key-here

# ------------------------------------------------------------------------------
# 2. Server-Only Supabase Service Role Key (CRITICAL SECURITY NOTICE)
# ------------------------------------------------------------------------------
# NEVER prefix this with NEXT_PUBLIC_.
# This key has full administrative access and bypasses Row Level Security (RLS).
# Used exclusively on the server for:
# - Background discovery scraper workers (discovery_runs, hackathon_source_records)
# - Verification history audit logging (verification_logs)
# - Administrative district directory updates
SUPABASE_SERVICE_ROLE_KEY=your-private-service-role-key-here

# ------------------------------------------------------------------------------
# 3. Application Host Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
