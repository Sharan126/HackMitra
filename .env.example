# ==============================================================================
# HackMitra Production & Local Environment Variables
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env.local:
#    cp .env.example .env.local
# 2. Never commit .env.local or secret keys to version control.
# 3. For production deployments (e.g. Vercel), add these keys in Project Settings.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Client-Side Public Supabase Configuration (Safe for browser, RLS-enforced)
# ------------------------------------------------------------------------------
# Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase Anon/Public Key (Subject to Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. Server-Only Supabase Service Role Key (CRITICAL SECURITY NOTICE)
# ------------------------------------------------------------------------------
# NEVER prefix with NEXT_PUBLIC_.
# This key bypasses Row Level Security (RLS) for backend pipeline jobs:
# - Scraper discovery engine ingestion (discovery_runs, hackathon_source_records)
# - Verification audit log writing (verification_logs)
# - Automated reminder processing (scheduled_reminders, notification_delivery_logs)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 3. Application Host Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://hackmitra.in

# ------------------------------------------------------------------------------
# 4. Supabase Project Reference & Database Configuration (Server-Only)
# ------------------------------------------------------------------------------
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_DB_REGION=ap-south-1
SUPABASE_DB_PASSWORD=your-secure-database-password

# ------------------------------------------------------------------------------
# 5. Administrative Dashboard Security Configuration (Server-Only)
# ------------------------------------------------------------------------------
# Secret key for HMAC-SHA256 administrative session signing
ADMIN_SECRET_KEY=generate_a_random_32_character_secret_here

# Statewide Moderator Credentials
ADMIN_EMAIL=admin@hackmitra.in
ADMIN_PASSWORD=SetAStrongProductionPasswordHere!2026

# ------------------------------------------------------------------------------
# 6. Background Worker & Cron Automation Token (Server-Only)
# ------------------------------------------------------------------------------
# Bearer token used to authenticate automated invocations of /api/cron/*
CRON_SECRET=generate_a_secure_cron_token_here_2026

# ------------------------------------------------------------------------------
# 7. Email & Transactional Notification Provider Configuration (Server-Only)
# ------------------------------------------------------------------------------
# Optional: Resend API Key (https://resend.com) for external email delivery
# If left blank, HackMitra defaults to its verified transactional delivery provider.
RESEND_API_KEY=re_your_resend_api_key_here

# Outgoing notification email sender address
NOTIFICATION_FROM_EMAIL=HackMitra Alerts <alerts@hackmitra.in>

# Optional Webhook URL for external event notification forwarding
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_SECRET=
